{
  "realm": "test2",
  "enabled": true,
  "displayName": "Test IdP2 Realm (Enterprise)",
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "attributes": {
    "saml.issuer": "http://localhost:11002/realms/test2"
  },
  "users": [
    {
      "username": "enterpriseuser",
      "enabled": true,
      "email": "enterpriseuser@company.com",
      "firstName": "Enterprise",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "enterprisepassword",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "http://localhost:10000",
      "name": "SAML Proxy Client",
      "enabled": true,
      "protocol": "saml",
      "frontchannelLogout": true,
      "publicClient": true,
      "fullScopeAllowed": true,
      "consentRequired": false,
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.force.post.binding": "true",
        "saml.multivalued.roles": "false",
        "saml.encrypt": "false",
        "saml.server.signature": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml.client.signature": "false",
        "saml.authnstatement": "true",
        "display.on.consent.screen": "false"
      },
      "redirectUris": [
        "http://localhost:10000/*"
      ],
      "baseUrl": "http://localhost:10000",
      "adminUrl": "http://localhost:10000",
      "protocolMappers": []
    }
  ]
}