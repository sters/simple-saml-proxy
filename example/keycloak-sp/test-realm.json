{
  "realm": "sp-realm",
  "enabled": true,
  "displayName": "Test SP Realm",
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "attributes": {
    "saml.issuer": "http://localhost:12000/realms/sp-realm"
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "test-app",
      "name": "Test Application",
      "rootUrl": "http://localhost:12000",
      "adminUrl": "http://localhost:12000",
      "baseUrl": "/realms/sp-realm/account",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:12000/*"
      ],
      "webOrigins": [
        "http://localhost:12000"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "http://localhost:10000",
      "name": "SAML Test Client",
      "enabled": true,
      "protocol": "saml",
      "frontchannelLogout": true,
      "attributes": {
        "saml.assertion.signature": "false",
        "saml.force.post.binding": "true",
        "saml.multivalued.roles": "false",
        "saml.encrypt": "false",
        "saml.server.signature": "false",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml.client.signature": "false",
        "saml.authnstatement": "true",
        "saml.server.signature.keyinfo.ext": "false",
        "saml_force_name_id_format": "false",
        "saml.assertion.lifespan": "600",
        "saml_assertion_consumer_url_post": "http://localhost:12000/realms/sp-realm/protocol/saml",
        "saml_name_id_format": "persistent"
      },
      "redirectUris": [
        "http://localhost:12000/*"
      ],
      "defaultClientScopes": [],
      "optionalClientScopes": []
    }
  ],
  "identityProviders": [
    {
      "alias": "saml-proxy",
      "displayName": "SAML Proxy",
      "providerId": "saml",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "syncMode": "FORCE",
        "hideOnLoginPage": "false",
        "validateSignature": "false",
        "postBindingResponse": "true",
        "postBindingAuthnRequest": "true",
        "postBindingLogout": "true",
        "wantAuthnRequestsSigned": "false",
        "wantAssertionsSigned": "false",
        "wantAssertionsEncrypted": "false",
        "addReadTokenRoleOnCreate": "false",
        "forceAuthn": "false",
        "signatureAlgorithm": "RSA_SHA256",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent",
        "principalType": "SUBJECT",
        "allowCreate": "true",
        "entityId": "http://localhost:10000",
        "singleSignOnServiceUrl": "http://localhost:10000/sso",
        "singleLogoutServiceUrl": "http://localhost:10000/metadata/SLO",
        "backchannelSupported": "false",
        "signingCertificate": ""
      }
    }
  ]
}
