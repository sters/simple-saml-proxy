{
  "realm": "sp-realm",
  "enabled": true,
  "displayName": "Test SP Realm",
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "attributes": {
    "saml.issuer": "http://localhost:8081/realms/sp-realm"
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [],
  "identityProviders": [
    {
      "alias": "saml-proxy",
      "displayName": "SAML Proxy",
      "providerId": "saml",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "syncMode": "FORCE",
        "hideOnLoginPage": "false",
        "validateSignature": "false",
        "postBindingResponse": "true",
        "postBindingAuthnRequest": "true",
        "postBindingLogout": "true",
        "wantAuthnRequestsSigned": "false",
        "wantAssertionsSigned": "false",
        "wantAssertionsEncrypted": "false",
        "forceAuthn": "false",
        "signatureAlgorithm": "RSA_SHA256",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent",
        "principalType": "SUBJECT",
        "allowCreate": "true",
        "entityId": "http://localhost:8082",
        "singleSignOnServiceUrl": "http://localhost:8082/metadata/sso",
        "singleLogoutServiceUrl": "http://localhost:8082/metadata/SLO",
        "backchannelSupported": "false"
      }
    }
  ]
}